# The repo root is the build context for cyber.backend and cyber.ai.engine so
# they can consume the cyber.contracts path dependency. Keep the context small.
**/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/node_modules/
**/.next/
**/out/
**/.git/
**/.gitignore
.env
.env.*
!.env.example

# Not needed by either Python image.
cyber.frontend/
cyber.mcp.server/
infrastructure/
scripts/
README.md
Makefile
docker-compose.yml
VERSION
