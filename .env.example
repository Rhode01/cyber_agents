# Cybersecurity Agents Platform - example environment.
#
# Copy to .env (make env) and fill in real values. Never commit .env.
# Docker Compose reads this file's copy at the repository root and passes the
# relevant subset into each service.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL (container: db) - consumed by the backend only
# ---------------------------------------------------------------------------
POSTGRES_USER=cyberagents
POSTGRES_PASSWORD=cyberagents
POSTGRES_DB=cyberagents
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis (container: redis) - arq broker for the backend worker
# ---------------------------------------------------------------------------
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# backend  (port 8000) - owns all persistence and all migrations
# ---------------------------------------------------------------------------
# Inside compose the host is "db"; running on the host it is "localhost".
DATABASE_URL=postgresql+asyncpg://cyberagents:cyberagents@localhost:5432/cyberagents
REDIS_URL=redis://localhost:6379/0
# Inside compose this is http://ai-engine:8003
AI_ENGINE_URL=http://localhost:8003
AI_ENGINE_TIMEOUT_SECONDS=60
CORS_ORIGINS=["http://localhost:3000"]
# Placeholder only - real auth is deferred past Phase 1.
SECRET_KEY=change-me-in-every-real-deployment

# ---------------------------------------------------------------------------
# ai.engine (port 8003) - LangGraph agents, no database access at all
# ---------------------------------------------------------------------------
# Default provider is OpenAI's hosted API. Leave OPENAI_BASE_URL empty to use
# it; set it to point ChatOpenAI at any OpenAI-compatible endpoint instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
OPENAI_TEMPERATURE=0.0
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
# Inside compose this is http://backend:8000
BACKEND_URL=http://localhost:8000
BACKEND_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# frontend (port 3000)
# ---------------------------------------------------------------------------
# Read by the browser, so it must be reachable from the host - not "backend".
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# mcpserver (port 8004) - stub in Phase 1
# ---------------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8004
MCP_SERVER_NAME=cyber-agents
# DNS-rebinding protection. Empty falls back to localhost / 127.0.0.1 /
# mcpserver on MCP_PORT; set explicitly for a real deployment hostname or the
# transport answers 421 Misdirected Request.
MCP_ALLOWED_HOSTS=[]
MCP_ALLOWED_ORIGINS=[]
