    { "name": "Microsoft", "aliases": ["microsoft", "office 365", "microsoft 365", "outlook", "onedrive", "sharepoint"], "domains": ["microsoft.com", "microsoftonline.com", "office.com", "live.com", "outlook.com", "sharepointonline.com"] },
