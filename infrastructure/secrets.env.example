# Every credential a deployment must supply, and nothing else.
#
# Copy per environment and load through your secret manager. Never commit a
# filled-in copy. These are read from the process environment only - the
# platform has no database-backed secret store by design.

# ---------------------------------------------------------------------------
# Shared by every service
# ---------------------------------------------------------------------------
# Authenticates service-to-service calls on all four hops: backend -> ai.engine,
# ai.engine -> mcpserver, mcpserver -> backend, ai.engine -> backend. It
# authenticates a SERVICE, not a user, and grants nothing about whose data may be
# read - browser-facing routes do not use it.
#
# REQUIRED. The ai.engine and the mcpserver refuse to start without it whenever
# APP_ENV is anything but "local", because their routes launch scans and spend
# model budget. The backend does start without it - it also serves the browser -
# but then leaves its finding-write routes unauthenticated.
#
#   openssl rand -hex 32
INTERNAL_KEY=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---------------------------------------------------------------------------
# cyber.backend
# ---------------------------------------------------------------------------
DATABASE_URL=
REDIS_URL=
# Placeholder until real auth lands; must be a long random value per environment.
SECRET_KEY=

# ---------------------------------------------------------------------------
# cyber.ai.engine
# ---------------------------------------------------------------------------
# The only place an LLM credential belongs. Never sent in a request body and
# never written to the database.
OPENAI_API_KEY=
# Optional: point ChatOpenAI at any OpenAI-compatible endpoint.
OPENAI_BASE_URL=
# Optional: set when using the Anthropic provider instead of OpenAI.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# cyber.mcp.server
# ---------------------------------------------------------------------------
# Not secrets, but a deployment will not work without them, and getting either
# wrong fails in a way that names no cause.
#
# The MCP SDK answers 421 Misdirected Request for an unrecognised Host header, so
# this must list the hostname callers actually use. Empty falls back to
# localhost / 127.0.0.1 / mcpserver on MCP_PORT, which covers Compose only.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
# Networks the scan tools may target. Anything outside is refused before nmap
# starts - without a bound, this port is a scanning proxy for whoever reaches it.
# Empty falls back to loopback plus the private ranges.
SCAN_ALLOWED_TARGETS=
